rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function ownUser(uid){ return signedIn() && request.auth.uid == uid; }
    function lienDe(uid){ return get(/databases/$(database)/documents/liens_employes/$(uid)); }
    function estEmployeDe(ownerUid){ return signedIn() && exists(/databases/$(database)/documents/liens_employes/$(request.auth.uid)) && lienDe(request.auth.uid).data.ownerUid == ownerUid && lienDe(request.auth.uid).data.get('suspendu',false) == false; }
    function roleEmploye(){ return lienDe(request.auth.uid).data.role; }
    function catalogueOwner(){ return get(/databases/$(database)/documents/catalogue_public/klabcenter).data.ownerUid; }
    function isClient(uid){ return exists(/databases/$(database)/documents/clients_portal/$(uid)) && get(/databases/$(database)/documents/clients_portal/$(uid)).data.role == 'client'; }
    function accesEmploye(ownerUid,dataId){ return estEmployeDe(ownerUid) && ((roleEmploye()=='secretaire' && dataId in ['kc_clients','kc_produits','kc_ventes','kc_factures','kc_fournisseurs','kc_commandes','kc_mouvements_stock','kc_services']) || (roleEmploye()=='tresorier' && dataId in ['kc_tresorerie','kc_depenses','kc_recettes','kc_commandes','kc_mouvements_stock'])); }
    match /liens_employes/{employeUid}{ allow read: if signedIn() && (request.auth.uid==employeUid || (resource!=null && resource.data.ownerUid==request.auth.uid)); allow create: if signedIn() && request.resource.data.ownerUid==request.auth.uid && request.resource.data.role in ['secretaire','tresorier']; allow update: if signedIn() && resource.data.ownerUid==request.auth.uid && request.resource.data.ownerUid==request.auth.uid && request.resource.data.role in ['secretaire','tresorier']; allow delete: if signedIn() && resource.data.ownerUid==request.auth.uid; }
    match /users/{userId}{
      allow read,create,update,delete: if ownUser(userId);
      match /data/{dataId}{ allow read,create,update,delete: if ownUser(userId) && dataId in ['kc_clients','kc_produits','kc_ventes','kc_depenses','kc_factures','kc_fournisseurs','kc_commandes','kc_mouvements_stock','kc_parametres','kc_tresorerie','kc_services','kc_recettes','kc_utilisateurs']; allow read,create,update: if accesEmploye(userId,dataId); }
      match /records/{domain}/items/{recordId}{ allow read,create,update: if ownUser(userId) && domain in ['clients','produits','ventes','depenses','factures','fournisseurs','commandes']; allow delete: if false; }
      match /migration_meta/{id}{ allow read,create,update: if ownUser(userId); allow delete: if false; }
      match /backups/{backupId}{ allow read,create: if ownUser(userId); allow update,delete: if false; }
    }
    match /journal_employes/{id}{ allow create: if signedIn() && estEmployeDe(request.resource.data.ownerUid) && request.resource.data.employeUid==request.auth.uid && request.resource.data.role==roleEmploye(); allow read: if signedIn() && resource.data.ownerUid==request.auth.uid; allow update,delete: if false; }
    match /journal_actions/{id}{ allow create: if signedIn() && request.resource.data.ownerUid==request.auth.uid; allow read: if signedIn() && resource.data.ownerUid==request.auth.uid; allow update,delete: if false; }
    match /kc_ajustements_financiers/{id}{ allow create: if signedIn() && request.resource.data.ownerUid==request.auth.uid; allow read: if signedIn() && resource.data.ownerUid==request.auth.uid; allow update,delete: if false; }
    match /kc_taches/{id}{ allow create,read,update: if signedIn() && request.resource.data.ownerUid==request.auth.uid; allow delete: if false; }
    match /kc_promotions/{id}{ allow create,read,update: if signedIn() && request.resource.data.ownerUid==request.auth.uid; allow delete: if false; }
    match /kc_preferences/{id}{ allow create,read,update: if signedIn() && request.resource.data.ownerUid==request.auth.uid; allow delete: if false; }
    match /catalogue_public/{id}{ allow read: if true; allow create,update: if signedIn() && request.resource.data.ownerUid==request.auth.uid && (resource==null || resource.data.ownerUid==request.auth.uid); allow delete: if signedIn() && resource.data.ownerUid==request.auth.uid; }
    match /clients_portal/{uid}{ allow create: if signedIn() && request.auth.uid==uid && request.resource.data.role=='client' && request.resource.data.ownerUid==catalogueOwner(); allow read: if signedIn() && (request.auth.uid==uid || (resource!=null && resource.data.ownerUid==request.auth.uid)); allow update: if signedIn() && ((request.auth.uid==uid && request.resource.data.ownerUid==resource.data.ownerUid && request.resource.data.role=='client') || resource.data.ownerUid==request.auth.uid); allow delete: if false; }
    match /demandes_clients/{id}{ allow create: if signedIn() && isClient(request.auth.uid) && request.resource.data.clientUid==request.auth.uid && request.resource.data.ownerUid==catalogueOwner(); allow read: if signedIn() && (resource.data.clientUid==request.auth.uid || resource.data.ownerUid==request.auth.uid); allow update,delete: if signedIn() && resource.data.ownerUid==request.auth.uid; }
    match /messages_clients/{id}{ allow create: if signedIn() && ((isClient(request.auth.uid)&&request.resource.data.clientUid==request.auth.uid&&request.resource.data.ownerUid==catalogueOwner())||request.resource.data.ownerUid==request.auth.uid); allow read: if signedIn() && (resource.data.clientUid==request.auth.uid||resource.data.ownerUid==request.auth.uid); allow update: if signedIn() && resource.data.ownerUid==request.auth.uid; allow delete: if false; }
    match /kc_parametres/{id}{ allow create: if signedIn() && request.resource.data.ownerUid==request.auth.uid; allow read,update,delete: if signedIn() && resource.data.ownerUid==request.auth.uid; }
    match /kc_tresorerie/{id}{ allow create: if signedIn() && request.resource.data.ownerUid==request.auth.uid; allow read,update,delete: if signedIn() && resource.data.ownerUid==request.auth.uid; allow read,create,update: if signedIn() && estEmployeDe(resource.data.ownerUid) && roleEmploye()=='tresorier'; }
  }
}
